{
  "name": "bpfls",
  "displayName": "bpftrace (bpfls)",
  "description": "bpftrace language support powered by the bpfls language server",
  "version": "0.3.1",
  "publisher": "anakin4747",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anakin4747/bpfls"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "bpftrace",
        "aliases": [
          "bpftrace"
        ],
        "extensions": [
          ".bt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "bpfls",
      "properties": {
        "bpfls.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the bpfls executable. Empty uses bpfls on PATH (or build/bpfls when run from the bpfls repository)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
