// A script to try bpfls on. Hover over probe types, config names, keywords,
// standard library names and the other marked constructs to see their docs
// from bpftrace's language.md and stdlib.md. The probes at the end are
// deliberately broken to show parser diagnostics.
//
// It is a tour of what bpfls understands, not a script meant to be run.

config = {
    cache_user_symbols = PER_PID;
    cpp_demangle = 1;
    lazy_symbolication = 0;
    license = "GPL";
    log_size = 1000000;
    max_bpf_progs = 1024;
    max_cat_bytes = 10240;
    max_map_keys = 4096;
    max_probes = 1024;
    max_strlen = 64;
    missing_probes = warn;
    on_stack_limit = 32;
    perf_rb_pages = 64;
    show_debug_info = 0;
    stack_mode = bpftrace;
    str_trunc_trailer = "..";
    print_maps_on_exit = 1;
    bpftrace_max_probes = 2048;
    unstable_tseries = warn;
}

import "helpers";

macro add_one(x) {
    x + 1
}

let @syscalls = hash(4096);

// Special probes.

begin {
    printf("Counting syscalls... Hit Ctrl-C to end.\n");
}

BEGIN {
    printf("Uppercase BEGIN and END work too.\n");
}

end {
    print(@syscalls);
}

END {
    clear(@syscalls);
}

self:signal:SIGUSR1 {
    print(@syscalls);
}

test:counts_start_empty {
    return 0;
}

bench:map_update {
    @syscalls[0] = count();
}

// Kernel probes, each with its short alias.

kprobe:do_nanosleep {
    $first = arg0;
    $tenth = arg10;
}

k:do_nanosleep { }

kretprobe:do_nanosleep { }

kr:do_nanosleep { }

fentry:do_nanosleep {
    $req = args.rqtp;
}

f:do_nanosleep { }

fexit:do_nanosleep { }

fr:do_nanosleep { }

tracepoint:raw_syscalls:sys_enter {
    @syscalls[comm] = count();
}

t:raw_syscalls:sys_exit { }

rawtracepoint:sys_enter { }

rt:sys_exit { }

iter:task { }

it:task_file { }

// User-space probes.

uprobe:/bin/bash:readline { }

u:/bin/bash:readline { }

uretprobe:/bin/bash:readline { }

ur:/bin/bash:readline { }

usdt:/usr/bin/python3:python:function__entry { }

U:/usr/bin/python3:python:function__return { }

// Timed and event probes.

profile:hz:99 { }

p:hz:99 { }

interval:s:1 { }

i:ms:100 { }

software:page-faults:100 { }

s:faults:100 { }

hardware:cache-misses:1000000 { }

h:cycles:1000000 { }

watchpoint:0x10000000:8:rw { }

w:0x10000000:8:w { }

// Language constructs: hover the keyword, operator or brackets.

interval:s:5 {
    import "more_helpers";

    // Positional parameters.
    $limit = $1;
    $count = $#;

    // Loops.
    for $i : 0..3 {
        printf("%d\n", $i);
    }
    for $kv : @syscalls {
        printf("%s\n", $kv.0);
    }
    while ($limit > 0) {
        $limit--;
    }
    unroll(3) {
        $count++;
    }

    // Conditionals.
    if ($count > 10) {
        print("many");
    } else {
        print("few");
    }
    $size = $count > 10 ? "many" : "few";

    // Increment and decrement.
    ++$count;
    --$count;

    // Tuples and records.
    $pair = (1, "one");
    $one = $pair.1;
    $point = (x = 1, y = 2);

    // Casts.
    $byte = (uint8)$count;

    // Type context builtins.
    $width = sizeof(uint64);
    $offset = offsetof(struct task_struct, pid);
    $type = typeof($count);
    $info = typeinfo($count);

    $next = add_one($count);
}

// Standard library: hover any helper or map value function.

kprobe:vfs_read {
    // Process and thread.
    $proc = (pid, tid, uid, gid, ppid, cpid, has_cpid(), comm, pcomm,
             username, leader_comm, leader_tid);

    // Where it ran.
    $place = (cpu, ncpus, numaid, arch, curtask, cwd, cgroup, cgroupid,
              cgroup_path(cgroup));

    // Clocks and randomness.
    $clock = (nsecs, elapsed, jiffies, rand, time("%H:%M:%S"),
              strftime("%H:%M:%S", nsecs));

    // What fired.
    $here = (probe, probetype, func, retval, usermode, socket_cookie(arg0));

    // Stacks, symbols and addresses.
    $stacks = (kstack, ustack, dw_ustack, ksym(reg("ip")), usym(reg("ip")),
               kaddr("do_nanosleep"), uaddr("main"),
               percpu_kaddr("runqueues"));

    // Strings and buffers.
    $text = (str(arg0), buf(arg1, 16), strlen("abc"), strncmp("a", "b", 1),
             strcontains("ab", "a"), strstr("ab", "b"), str_concat("a", "b"),
             strcap("abc", 2), join(arg1), path(arg0), abs_path(arg0),
             strerror(2), syscall_name(0), signal_name(9), macaddr(arg0),
             ntop(arg0), pton("127.0.0.1"), memcmp(arg0, arg1, 4), bswap(arg0),
             default_str_length);

    // Values, pointers and maps.
    $checks = (is_array(arg0), is_err(arg0), is_integer(arg0), is_literal(1),
               is_ptr(arg0), is_str("a"), is_unsigned_integer(arg0),
               kptr(arg0), uptr(arg0), container_of(arg0, task_struct, tasks),
               kfunc_allowed("bpf_get_task_stack"),
               kfunc_exist("bpf_get_task_stack"), find(@syscalls, 0),
               has_key(@syscalls, 0), len(@syscalls));

    // Sizes and options.
    $sizes = (sizeof(uint64), offsetof(struct task_struct, pid), typeof(arg0),
              config("max_strlen"), getopt("verbose"));

    // Map value functions.
    @calls = count();
    @bytes = sum(arg2);
    @mean = avg(arg2);
    @least = min(arg2);
    @most = max(arg2);
    @summary = stats(arg2);
    @sizes = hist(arg2);
    @buckets = lhist(arg2, 0, 1000, 100);
    @series = tseries(arg2, 1000000000, 10);

    // Output and side effects.
    print(@calls);
    printf("%d\n", pid);
    errorf("bad value %d", arg2);
    warnf("odd value %d", arg2);
    assert(arg2 >= 0, "negative read");
    assert_str("abc", "abc");
    static_assert(1, "always true");
    cat("/proc/loadavg");
    system("true");
    signal("SIGUSR1");
    signal_thread("SIGUSR1");
    override(0);
    skboutput("out.pcap", arg0, 64, 0);
    unwatch(0);
    write_user(arg0, 0);
    delete(@calls, 0);
    zero(@bytes);
    clear(@mean);
    fail("unreachable");
    exit();
}

// The probes below are deliberately broken, to show parser diagnostics. Each
// has one mistake, because after an error the parser skips the rest of that
// statement, which can hide a second mistake close by.

interval:s:1 {
    $x = ;
}

interval:s:2 {
    print("one") print("two");
}

kprobe:do_nanosleep {
    printf("\xZZ\n");
}

kprobe:do_nanosleep {
    @calls = 1_;
}

tracepoint:raw_syscalls:sys_exit {
    1++;
}
